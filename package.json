{
  "name": "tokviz",
  "version": "0.1.0",
  "description": "Real-time, local-only web dashboard that visualizes LLM token usage and costs from standard OpenTelemetry data",
  "type": "module",
  "bin": {
    "tokviz": "dist/server/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"tsx watch src/server/index.ts --no-open\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts --no-open",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup",
    "start": "node dist/server/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opentelemetry",
    "otlp",
    "llm",
    "tokens",
    "cost",
    "dashboard",
    "gen-ai",
    "observability"
  ],
  "author": "Waldek Mastykarz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/waldekmastykarz/tokviz.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "open": "^10.1.0",
    "protobufjs": "^7.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
